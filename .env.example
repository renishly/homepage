# Copy this file to .env and fill in your own values:
#     cp .env.example .env
# Never commit .env (it's already in .gitignore).

# Username and password for the dashboard's login page (/login).
# Changing either one signs every device out.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=replace-me-with-a-strong-password

# Agent editing password: you type it to delete an agent, or to view or
# replace an agent's API key. Use something different from your dashboard
# password. If empty, those actions are turned off.
AGENT_EDIT_PASSWORD=replace-me-with-an-agent-editing-password

# Secret used to encrypt agents' API keys in the database, so "View key" can
# show them again. Generate one with:
#     python -c "import secrets; print(secrets.token_hex(32))"
# Keep it safe and don't change it: keys saved with an old secret can't be
# viewed any more (use "Replace key" to fix an agent if that happens).
KEY_ENCRYPTION_SECRET=replace-me-with-a-long-random-secret

# Optional. Leave empty to use a local SQLite file (./local.db).
# On Render this is set for you automatically from the Postgres database.
DATABASE_URL=

# Used by agent/agent.py (the demo agent) only, not by the website:
# - DASHBOARD_API_KEY: the demo agent's own key, from the dashboard's
#   "Add Agent" card. Each agent you run needs its own key.
# - DASHBOARD_URL: where the dashboard is. Defaults to http://127.0.0.1:8000;
#   set it to e.g. https://your-service.onrender.com or your own domain to
#   talk to a deployed dashboard.
DASHBOARD_API_KEY=
DASHBOARD_URL=http://127.0.0.1:8000
